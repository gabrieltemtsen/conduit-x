{
  "name": "conduit-x-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter \"@conduitx/*\" dev",
    "dev:console": "pnpm --filter @conduitx/console dev",
    "dev:sellers": "pnpm --filter \"@conduitx/seller-*\" dev",
    "dev:broker": "pnpm --filter @conduitx/broker dev",
    "dev:registry": "pnpm --filter @conduitx/registry dev",
    "dev:mcp": "pnpm --filter @conduitx/mcp dev",
    "build": "pnpm --filter \"@conduitx/*\" build",
    "test": "pnpm --filter \"@conduitx/*\" test",
    "lint": "pnpm --filter \"@conduitx/*\" lint"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5"
  }
}
