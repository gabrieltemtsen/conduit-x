# Service discovery + reputation indexer.
# Seller *_URL / *_ACCOUNT_ID vars only need overriding when sellers run
# on non-default ports or hosts (defaults assume localhost:4001-4003).

PORT=4000
HEDERA_HCS_TOPIC_ID=0.0.5694210
SELLER_POOLS_URL=http://localhost:4001/query
SELLER_POOLS_ACCOUNT_ID=0.0.5694201
SELLER_RISK_URL=http://localhost:4002/query
SELLER_RISK_ACCOUNT_ID=0.0.5694202
SELLER_PORTFOLIO_URL=http://localhost:4003/query
SELLER_PORTFOLIO_ACCOUNT_ID=0.0.5694203
STANDALONE=true
